# ---------------------------------------------------------------------------
# Alcove environment variables
#
# Copy this file to `.env.local` and fill in your own values:
#     cp .env.example .env.local
#
# Heads up: variables live in THREE places depending on where the code runs.
#   - .env.local         -> Next.js dev server + the local CLI scripts
#   - Convex deployment  -> the in-app "Add apartment by URL" importer action,
#                           set with `npx convex env set NAME value`
#   - Your host (Vercel) -> the deployed Next.js app (mirror the values below)
# Each variable notes where it is needed.
# ---------------------------------------------------------------------------

# === Convex (database + backend) ===========================================
# Created automatically the first time you run `npx convex dev`. It writes
# CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL into .env.local for you.
# NEXT_PUBLIC_CONVEX_URL is the only one the app strictly needs.        [app]
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# === Anthropic (AI URL importer) ===========================================
# Powers the in-app "Add apartment by URL" flow (convex/apartmentImportActions).
# This runs INSIDE Convex, so it must be set on the Convex deployment:
#     npx convex env set ANTHROPIC_API_KEY sk-ant-...
# Requires an Anthropic account with the web_search / web_fetch tools enabled.
# Get a key: https://console.anthropic.com/settings/keys              [convex]
ANTHROPIC_API_KEY=
# Optional model override (defaults to alcove.config.mjs -> anthropicModel).
# ANTHROPIC_MODEL=claude-sonnet-4-6

# === Cloudflare R2 (image storage, S3-compatible) ==========================
# Needed wherever images are uploaded or served:
#   - local import script (npm run import:apartment-runs)              [local]
#   - in-app importer image upload -> set on Convex too               [convex]
#   - the /api/images/r2 proxy in the running app                     [app]
# Create an R2 bucket + S3 API token in the Cloudflare dashboard.
R2_S3_API_URL=https://<account_id>.r2.cloudflarestorage.com
R2_S3_ACCESS_KEY_ID=
R2_S3_SECRET_ACCESS_KEY=
# Bucket name. If omitted, it is inferred from R2_S3_API_URL or defaults
# to "alcove". R2_BUCKET_NAME wins over R2_BUCKET.
R2_BUCKET_NAME=alcove
# Optional: a public custom domain mapped to the bucket. If set, images are
# served directly from it; if omitted, they are served via /api/images/r2.
# R2_PUBLIC_URL=https://assets.example.com
# NEXT_PUBLIC_R2_PUBLIC_URL=https://assets.example.com

# === Google Static Maps (optional) =========================================
# Renders the location map in the apartment drawer. If unset, location previews
# are disabled. Restrict the key to the Static Maps API and your domains.
# Get a key: https://console.cloud.google.com/google/maps-apis         [app]
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# === App metadata (optional) ===============================================
# Absolute base URL used for Open Graph / canonical metadata.          [app]
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
